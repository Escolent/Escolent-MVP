# Copy to .env.local for local development (or .env when running scripts
# outside Next.js, e.g. one-off Node scripts). Never commit real values.

# --- Supabase project (Data Layer — design.md "Technology Stack") ---
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses Row Level Security — see src/lib/supabase/service-role.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- supabase/migrations test harness (tests/db/**) ---
# Local Postgres only, unrelated to the Supabase project above.
# See supabase/migrations/README.md and scripts/db/setup-local-test-db.sh.
TEST_DATABASE_URL=postgres://escolent:escolent_dev_pw@127.0.0.1:5432/escolent_test
TEST_DATABASE_APP_URL=postgres://escolent_app_user:escolent_app_pw@127.0.0.1:5432/escolent_test
